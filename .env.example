# ================================================================
# YouTube Music Alexa Skill - Environment Variables Template
# Copy this file to .env and fill in your values.
# ================================================================

# YouTube Data API v3 Key (Recommended for fastest search responses)
# If left empty, search automatically falls back to web scraping and yt-dlp
YOUTUBE_API_KEY=

# Your Alexa Skill ID from the Amazon Alexa Developer Console
# Format: amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ALEXA_SKILL_ID=

# Cloud State Sync URL (Optional: used to share player queue between local and cloud)
CLOUD_STATE_URL=

# Proxy URL for stream extraction (Optional: e.g. http://username:password@ip:port)
DEBUG_PROXY_URL=

# Reserved Ngrok Domain (Optional: if you use a free/paid static ngrok domain)
NGROK_DOMAIN=

# Cloudflare Worker or Edge Streamer URL (Optional)
WORKER_STREAM_URL=

# Custom path to cookies.txt (Optional: defaults to checking ./cookies.txt and ./lambda/cookies.txt)
COOKIES_PATH=
